{
  "schema": "olympus-site-relay-feed-fixtures",
  "version": 1,
  "status": "reference-proposal-not-production",
  "privacy": "All identities are invented fixture identifiers. No expected relay wire value contains contributor evidence.",
  "nonGoals": [
    "No production endpoint, host, key or credential is represented.",
    "No signature is generated or cryptographically verified.",
    "The reference validator checks declared structure and policy coherence; it does not execute the production aggregation or atomic replay-store algorithms.",
    "These fixtures do not activate or modify the manual export, Army QR or Olympus Link."
  ],
  "proposedPolicy": {
    "scopeId": "forever-pve-alliance",
    "allowedGuilds": [
      "Olympus",
      "Olympus I",
      "Olympus II",
      "Olympus III",
      "Olympus IV",
      "Olympus V",
      "Olympus VI",
      "Olympus VII",
      "Olympus VIII",
      "Olympus IX",
      "Olympus X"
    ],
    "minimumQuorum": 2,
    "strictMajority": true,
    "characterFreshnessSeconds": 1800,
    "onlineFreshnessSeconds": 900,
    "characterTolerance": "PROPOSED: max(5, ceil(0.05 * max(a,b)))",
    "onlineTolerance": "PROPOSED: max(2, ceil(0.05 * max(a,b)))",
    "clusterRule": "A valid cluster is pairwise compatible from minimum to maximum; adjacency is never transitively chained.",
    "medianRule": "OPEN DECISION: lower median or rounded middle-pair median",
    "manualRelaySeparation": true,
    "fixtureMedianRule": "rounded-middle-pair-provisional-option-a"
  },
  "cases": [
